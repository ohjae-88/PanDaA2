{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "판다의 A2",
  "version": "../package.json",
  "identifier": "com.pandaa2.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "판다의 A2",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "center": true,
        "dragDropEnabled": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgNjgyQ0YwNkM2NDcwMTkwMQpSV1JvTFBCc1pIQVpBWnZZakE0SEJTVmlxdUpLSHovQ3NCdVMrSjdjTGIzT3kzWGdJUUZJamR5ago=",
      "endpoints": [
        "https://github.com/ohjae-88/PanDaA2/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/ocr/det.onnx": "ocr/det.onnx",
      "resources/ocr/cls.onnx": "ocr/cls.onnx",
      "resources/ocr/rec.onnx": "ocr/rec.onnx",
      "resources/ocr/korean_dict.txt": "ocr/korean_dict.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "AION2 컴패니언 — 배럭 / 파티 / 아르카나 / 알리미",
    "longDescription": "판다의 A2 통합 — AION2 게임 관리 도구. 인게임 오버레이 지원 예정.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["Korean", "English"]
      }
    }
  }
}
